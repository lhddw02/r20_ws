<?xml version="1.0"?>
<package format="3">
  <name>snail_bottle_approach</name>
  <version>0.1.0</version>
  <description>RealSense RGB-D bottle detection and low-speed R20 TWD approach.</description>
  <maintainer email="maintainer@example.com">Snail Robot Project</maintainer>
  <license>LicenseRef-Project-Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>snail_hardware</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
